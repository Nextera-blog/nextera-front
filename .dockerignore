.env
.env.local
.env.development
.env.production

# Fichiers de cache et temporaires
npm-debug.log
yarn-debug.log
yarn-error.log

# Dossiers spécifiques aux IDE
.vscode/

# Fichiers spécifiques au système d'exploitation
.DS_Store
